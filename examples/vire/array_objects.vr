// Array of objects — a ref-element array whose slots hold `Node` references.
// `mut x: Array[Node] = array(n)` declares the element class: `x[i] = Node(...)`
// is class-checked and `x[i].field` resolves. A whole pool built, cross-linked
// and consumed inside one loop iteration is freed by the loop-arena en bloc (no
// per-node reference counting) — see benchmarks/complex/arraygraph.vr.
type Node { id: Int  next: Node }

fn main() {
    mut pool: Array[Node] = array(5)
    mut i = 0
    while i < 5 { pool[i] = Node(i * i, null)  i = i + 1 }
    // cross-link consecutive slots into a chain
    mut j = 0
    while j < 4 { pool[j].next = pool[j + 1]  j = j + 1 }
    // walk the chain from slot 0, summing the squares 0+1+4+9+16 = 30
    mut c = pool[0]
    mut sum = 0
    while c != null { sum = sum + c.id  c = c.next }
    print(sum)
}
