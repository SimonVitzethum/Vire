// Static reflection (P0 of the dynamic-runtime plan): type_name / field_count / abi_version
// are resolved at compile time from the type graph — no runtime metadata, no RTTI cost.
type Shape { kind: Int  area: Float }

fn main() {
    mut s = Shape(1, 3.14)
    print(type_name(s))       // Shape
    print(field_count(s))     // 2
    print(abi_version())      // 1 — the frozen dynamic-ABI anchor
}
