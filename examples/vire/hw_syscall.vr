// Hardware without inline asm (language/HW-SAFE.md H2): declared syscalls,
// compiler fences. No user-written asm, no C, no flags — just `vire run`.
// (MMIO needs `--hw-profile` + real hardware; see tests/vire_hw.sh.)

syscall sys_getpid() -> Int = 39
syscall sys_write(fd: Int, buf: Array[Byte], n: Int) -> Int = 1

fn main() {
    fence()
    mut pid = sys_getpid()
    print(pid > 0)                  // 1
    mut msg = barray(4)
    msg[0] = 111  msg[1] = 107  msg[2] = 33  msg[3] = 10
    mut n = sys_write(1, msg, 4)    // ok!\n via the kernel, returns 4
    print(n)                        // 4
    fence_rel()
}
