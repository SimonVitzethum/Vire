// Type inference — the ergonomics claim, demonstrated instead of asserted.
//
// Locals never need annotations, and signatures need them only where the
// monomorphic unifier cannot see through (object field types live in lowering,
// not in inference — annotate the signature, E100). Run it:
//   vire run examples/vire/inferred.vr
//
// (The graphics/thread examples in this folder annotate every signature for
//  readability; that is a style choice, not a language requirement — as this
//  file shows.)

type Vec2 { x: Int y: Int }

fn dot(a: Vec2, b: Vec2) -> Int {   // return type annotated (E100)
    a.x * b.x + a.y * b.y
}

fn lensq(v: Vec2) -> Int {            // fully annotated (E100)
    dot(v, v)
}

fn scale(x: Float) -> Float {         // annotated (E100)
    x * 2.0
}

fn main() {
    mut p = Vec2(3, 4)
    print(lensq(p))                   // 3*3 + 4*4 = 25
    print(scale(1.5))                 // 3.0
}
