type Node {
    next: Node
    v: Int
}
// M3 variant of ring.vr: the ring (a real cycle) lives and dies in a declared
// pool — freed en bloc WITHOUT the cycle collector (pools don't traverse, so
// cycles are irrelevant to them). Same values as ring.vr.
fn make_ring(n: Int) -> Int {
    mut s = region(n * 64) {
        mut head = Node(null, 0)
        mut prev = head
        mut i = 1
        while i < n {
            mut node = Node(null, i)
            prev.next = node
            prev = node
            i = i + 1
        }
        prev.next = head
        head.v + prev.v
    }
    s
}
fn main() {
    mut r = 0
    mut k = 0
    while k < 50 {
        r = r + make_ring(2000)
        k = k + 1
    }
    print(r)
}
